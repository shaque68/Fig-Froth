# Copy to .env. Never commit a real access token.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
APP_BASE_URL=http://localhost:5173
PORT=3001
SQUARE_API_VERSION=2025-08-20
MERCHANT_SUPPORT_EMAIL=figandfroth@gmail.com
# Optional: lets the Behind the Counter demo's Claude mode write its explanations.
# Leave blank to keep the demo fully offline (Demo mode).
ANTHROPIC_API_KEY=
# Owner sign-in for Behind the Counter (/admin). Required to open the admin pages.
OWNER_PASSWORD=
# Optional: keeps owners signed in across server restarts. Use a long random string.
SESSION_SECRET=
